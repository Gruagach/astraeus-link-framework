# Create a single-file quality gate as requested.
from textwrap import dedent

code = dedent(r'''
#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
Quality Gate (AUTO QA) – single-file
------------------------------------
Implements the gating rule you proposed:

    if metrics.delta_r <= targets.delta_r_max and metrics.chi >= targets.chi_min:
        allow = all(check.pass for check in checks)
    else:
        allow = False  # SANDBOX routing

Extensions:
- Optional ECR threshold (ecr_min)
- Optional hard limit on delta_r to trigger BLOCK (e_stop_delta_r)
- Summarizes failing checks and emits machine-readable decision JSON

Inputs
------
- metrics.json : {"delta_r": 0.01, "chi": 0.94, "ecr": 0.98, ...}
- checks.json  : list of check results, e.g. from PCL/Corridor
                 [{"id":"PCL:EM-BC-001","passed":true,...}, ...]
- targets.(yaml|yml|json): thresholds. Example YAML (flat keys):
    DELTA_R_MAX: 0.03
    CHI_MIN: 0.90
    ECR_MIN: 0.90
    E_STOP_DELTA_R: 0.20

CLI
---
python quality_gate_single.py decide \
  --metrics metrics.json \
  --checks checks.json \
  --targets targets.yaml \
  --out decision.json

Exit codes: 0=ALLOW, 10=SANDBOX, 20=BLOCK, 2=error
"""
from __future__ import annotations
import argparse, json, sys, os, re
from pathlib import Path
from typing import Any, Dict, List, Optional

# --------- minimal YAML/JSON loader ---------
def load_struct(path: Path) -> Dict[str, Any] | List[Any]:
    text = path.read_text(encoding="utf-8").strip()
    # try JSON first
    try:
        return json.loads(text)
    except Exception:
        pass
    # naive YAML (flat key: value pairs)
    data: Dict[str, Any] = {}
    for line in text.splitlines():
        line = line.strip()
        if not line or line.startswith("#"): 
            continue
        if ":" not in line:
            raise ValueError(f"Unsupported YAML line (expected key: value): {line}")
        k, v = line.split(":", 1)
        k = k.strip()
        v = v.strip()
        # strip quotes
        v = v.strip('"').strip("'")
        # try to coerce numbers/bools
        if re.fullmatch(r"[-+]?\d+\.\d*", v):
            val: Any = float(v)
        elif re.fullmatch(r"[-+]?\d+", v):
            val = int(v)
        elif v.lower() in ("true","false"):
            val = (v.lower() == "true")
        elif v.lower() in ("null","none","~",""):
            val = None
        else:
            val = v
        data[k] = val
    return data

# --------- core logic ---------
def decide(metrics: Dict[str, Any], checks: List[Dict[str, Any]], targets: Dict[str, Any]) -> Dict[str, Any]:
    # thresholds
    delta_r_max = float(targets.get("DELTA_R_MAX", 0.03))
    chi_min     = float(targets.get("CHI_MIN", 0.90))
    ecr_min     = float(targets.get("ECR_MIN", 0.0))  # optional
    e_stop_max  = targets.get("E_STOP_DELTA_R", None)
    if e_stop_max is not None:
        e_stop_max = float(e_stop_max)

    # metrics
    delta_r = float(metrics.get("delta_r", 0.0))
    chi     = float(metrics.get("chi", 1.0))
    ecr     = float(metrics.get("ecr", 1.0))

    # summarize checks
    total = len(checks)
    failing = [c for c in checks if not bool(c.get("passed", False))]
    all_pass = (len(failing) == 0)

    # default decision
    decision = "SANDBOX"
    reasons: List[str] = []
    policy_applied = {
        "delta_r_max": delta_r_max, "chi_min": chi_min, "ecr_min": ecr_min,
        "e_stop_delta_r": e_stop_max
    }

    # E-STOP?
    if (e_stop_max is not None) and (delta_r > e_stop_max):
        decision = "BLOCK"
        reasons.append(f"delta_r_exceeds_e_stop({delta_r}>{e_stop_max})")
    else:
        # main rule
        cond = (delta_r <= delta_r_max) and (chi >= chi_min) and (ecr >= ecr_min)
        if cond and all_pass:
            decision = "ALLOW"
        else:
            decision = "SANDBOX"
            if not cond:
                if delta_r > delta_r_max: reasons.append("delta_r_too_high")
                if chi < chi_min:         reasons.append("chi_too_low")
                if ecr < ecr_min:         reasons.append("ecr_too_low")
            if not all_pass:
                reasons.append(f"{len(failing)}_checks_failed")

    # assemble details
    out = {
        "decision": decision,
        "reasons": reasons,
        "metrics": {"delta_r": delta_r, "chi": chi, "ecr": ecr},
        "targets": policy_applied,
        "checks_summary": {
            "total": total,
            "failed": len(failing),
            "failed_ids": [c.get("id","unknown") for c in failing][:16]  # cap
        }
    }
    return out

# --------- CLI ---------
def main(argv: Optional[List[str]] = None) -> int:
    ap = argparse.ArgumentParser(description="Quality Gate (AUTO QA) – ALLOW/SANDBOX/BLOCK")
    ap.add_argument("--metrics", type=Path, required=True, help="metrics.json")
    ap.add_argument("--checks", type=Path, required=True, help="checks.json (list of objects with 'passed' key)")
    ap.add_argument("--targets", type=Path, required=True, help="targets.(yaml|json)")
    ap.add_argument("--out", type=Path, help="write decision JSON here")
    args = ap.parse_args(argv)

    try:
        metrics = load_struct(args.metrics)  # dict
        checks  = load_struct(args.checks)   # list
        targets = load_struct(args.targets)  # dict
        if not isinstance(metrics, dict): raise ValueError("metrics must be JSON object")
        if not isinstance(checks, list):  raise ValueError("checks must be JSON array")
        if not isinstance(targets, dict): raise ValueError("targets must be mapping")

        decision = decide(metrics, checks, targets)

        text = json.dumps(decision, ensure_ascii=False, indent=2, sort_keys=True)
        if args.out:
            args.out.write_text(text, encoding="utf-8")
            print(f"[OK] decision written: {args.out}")
        else:
            print(text)

        # exit codes by decision
        if decision["decision"] == "ALLOW":
            return 0
        elif decision["decision"] == "SANDBOX":
            return 10
        elif decision["decision"] == "BLOCK":
            return 20
        else:
            return 2

    except Exception as e:
        sys.stderr.write(f"[ERR] {e}\n")
        return 2

if __name__ == "__main__":
    raise SystemExit(main())
''')

path = "/mnt/data/quality_gate_single.py"
with open(path, "w", encoding="utf-8") as f:
    f.write(code)

path
