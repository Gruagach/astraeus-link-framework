    pe.add_argument("--ex")
    pe.add_argument("--ey")
    pe.add_argument("--ez")
    pe.add_argument("--rho")
    pe.add_argument("--epsilon0", type=float, default=8.854e-12)
    pe.add_argument("--tol-divE", type=float)

    # QFT
    pq = sub.add_parser("check-qft", help="Run QFT RG consistency (PCL:QFT-RG-010)")
    pq.add_argument("--model", required=True, help="QCD|QED|phi4|custom")
    pq.add_argument("--alpha1", type=float, required=True)
    pq.add_argument("--mu1", type=float, required=True)
    pq.add_argument("--alpha2", type=float, required=True)
    pq.add_argument("--mu2", type=float, required=True)
    pq.add_argument("--beta0", type=float)
    pq.add_argument("--min-consistency", type=float, default=0.6)

    # Resonance
    pr = sub.add_parser("cor-res-avoid", help="Resonance avoidance check (COR:RES-AVOID-005)")
    pr.add_argument("--signal", required=True, help="CSV or NPY, single-column time series")
    pr.add_argument("--dt", type=float, required=True)
    pr.add_argument("--drive-freq", type=float)
    pr.add_argument("--amp-th", type=float, default=3.0)
    pr.add_argument("--df-th", type=float, default=0.02)
    pr.add_argument("--q-th", type=float, default=10.0)

    # Gate (combined)
    pg = sub.add_parser("gate", help="Run all relevant checks and return a decision")
    pg.add_argument("--bx")
    pg.add_argument("--by")
    pg.add_argument("--bz")
    pg.add_argument("--dx", type=float)
    pg.add_argument("--dy", type=float)
    pg.add_argument("--dz", type=float)
    pg.add_argument("--tol-divB", type=float, default=1e-3)
    pg.add_argument("--ex")
    pg.add_argument("--ey")
    pg.add_argument("--ez")
    pg.add_argument("--rho")
    pg.add_argument("--epsilon0", type=float, default=8.854e-12)
    pg.add_argument("--tol-divE", type=float)

    pg.add_argument("--model")
    pg.add_argument("--alpha1", type=float)
    pg.add_argument("--mu1", type=float)
    pg.add_argument("--alpha2", type=float)
    pg.add_argument("--mu2", type=float)
    pg.add_argument("--beta0", type=float)
    pg.add_argument("--min-consistency", type=float, default=0.6)

    pg.add_argument("--signal")
    pg.add_argument("--dt", type=float)
    pg.add_argument("--drive-freq", type=float)
    pg.add_argument("--amp-th", type=float, default=3.0)
    pg.add_argument("--df-th", type=float, default=0.02)
    pg.add_argument("--q-th", type=float, default=10.0)

    pg.add_argument("--policy", type=str, help="JSON policy path")

    args = ap.parse_args()

    if args.cmd == "check-em":
        bx = load_arr(args.bx); by = load_arr(args.by); bz = load_arr(args.bz)
        ex = load_arr(args.ex) if args.ex else None
        ey = load_arr(args.ey) if args.ey else None
        ez = load_arr(args.ez) if args.ez else None
        rho = load_arr(args.rho) if args.rho else None
        res = pcl_em_bc_001(bx, by, bz, args.dx, args.dy, args.dz,
                            tol_divB=args.tol_divB,
                            ex=ex, ey=ey, ez=ez, rho=rho,
                            epsilon0=args.epsilon0,
                            tol_divE=args.tol_divE)
        print(safe_json(res))
        return

    if args.cmd == "check-qft":
        res = pcl_qft_rg_010(args.model, args.alpha1, args.mu1, args.alpha2, args.mu2,
                             beta0=args.beta0, min_consistency=args.min_consistency)
        print(safe_json(res))
        return

    if args.cmd == "cor-res-avoid":
        sig = load_arr(args.signal)
        res = cor_res_avoid_005(sig, dt=args.dt, drive_freq=args.drive_freq,
                                amp_th=args.amp_th, df_th=args.df_th, q_th=args.q_th)
        print(safe_json(res))
        return

    if args.cmd == "gate":
        # Load policy if any
        policy = None
        if args.policy:
            with open(args.policy, "r", encoding="utf-8") as f:
                policy = json.load(f)

        em = None
        if args.bx and args.by and args.bz and args.dx and args.dy and args.dz:
            bx = load_arr(args.bx); by = load_arr(args.by); bz = load_arr(args.bz)
            ex = load_arr(args.ex) if args.ex else None
            ey = load_arr(args.ey) if args.ey else None
            ez = load_arr(args.ez) if args.ez else None
            rho = load_arr(args.rho) if args.rho else None
            tol_divE = args.tol_divE if args.tol_divE is not None else None
            em = pcl_em_bc_001(bx, by, bz, args.dx, args.dy, args.dz,
                               tol_divB=args.tol_divB,
                               ex=ex, ey=ey, ez=ez, rho=rho,
                               epsilon0=args.epsilon0,
                               tol_divE=tol_divE)

        qft = None
        if args.model and (args.alpha1 is not None) and (args.alpha2 is not None) and (args.mu1 is not None) and (args.mu2 is not None):
            qft = pcl_qft_rg_010(args.model, args.alpha1, args.mu1, args.alpha2, args.mu2,
                                 beta0=args.beta0, min_consistency=args.min_consistency)

        res = None
        if args.signal and args.dt:
            sig = load_arr(args.signal)
            res = cor_res_avoid_005(sig, dt=args.dt, drive_freq=args.drive_freq,
                                    amp_th=args.amp_th, df_th=args.df_th, q_th=args.q_th)

        decision = gate_decision(em, qft, res, policy=policy)
        print(safe_json(decision))
        return


if __name__ == "__main__":
    main()
