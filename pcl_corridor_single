    import numpy as np
except Exception as e:
    raise SystemExit("NumPy is required. Please install numpy.")


# -----------------------------
# Utils
# -----------------------------

def load_arr(path: Optional[str]) -> Optional[np.ndarray]:
    if not path:
        return None
    p = Path(path)
    if not p.exists():
        raise FileNotFoundError(path)
    if p.suffix.lower() == ".npy":
        return np.load(p)
    # assume CSV (one or multi-column)
    return np.loadtxt(p, delimiter=",")

def finite_diff_divergence(Fx: np.ndarray, Fy: np.ndarray, Fz: np.ndarray,
                           dx: float, dy: float, dz: float) -> np.ndarray:
    """Compute ∇·F by central differences (1st-order edges, 2nd-order interior)."""
    assert Fx.shape == Fy.shape == Fz.shape, "Field component shapes must match."
    nx, ny, nz = Fx.shape
    div = np.zeros_like(Fx, dtype=float)

    # dFx/dx
    dFx = np.zeros_like(Fx, dtype=float)
    dFx[1:-1,:,:] = (Fx[2:,:,:] - Fx[:-2,:,:])/(2*dx)
    dFx[0,:,:]    = (Fx[1,:,:] - Fx[0,:,:])/dx
    dFx[-1,:,:]   = (Fx[-1,:,:] - Fx[-2,:,:])/dx

    # dFy/dy
    dFy = np.zeros_like(Fy, dtype=float)
    dFy[:,1:-1,:] = (Fy[:,2:,:] - Fy[:,:-2,:])/(2*dy)
    dFy[:,0,:]    = (Fy[:,1,:] - Fy[:,0,:])/dy
    dFy[:,-1,:]   = (Fy[:,-1,:] - Fy[:,-2,:])/dy

    # dFz/dz
    dFz = np.zeros_like(Fz, dtype=float)
    dFz[:,:,1:-1] = (Fz[:,:,2:] - Fz[:,:,:-2])/(2*dz)
    dFz[:,:,0]    = (Fz[:,:,1] - Fz[:,:,0])/dz
    dFz[:,:,-1]   = (Fz[:,:,-1] - Fz[:,:,-2])/dz

    div = dFx + dFy + dFz
    return div

def percentile(x: np.ndarray, q: float) -> float:
    return float(np.percentile(x, q))

def safe_json(obj: Dict[str, Any]) -> str:
    return json.dumps(obj, ensure_ascii=False, indent=2, sort_keys=True)


# -----------------------------
# PCL: EM-BC-001
# -----------------------------

def pcl_em_bc_001(bx: np.ndarray, by: np.ndarray, bz: np.ndarray,
                  dx: float, dy: float, dz: float,
                  tol_divB: float = 1e-3,
                  ex: Optional[np.ndarray] = None,
                  ey: Optional[np.ndarray] = None,
                  ez: Optional[np.ndarray] = None,
                  rho: Optional[np.ndarray] = None,
                  epsilon0: float = 8.854e-12,
                  tol_divE: Optional[float] = None) -> Dict[str, Any]:
    """
    Check ∇·B≈0 and optionally ∇·E≈rho/ε0 on a grid.
    Returns: {"id":"PCL:EM-BC-001", "passed":bool, "score":0..1, "violations":[...], "stats":{...}}
    """
    divB = finite_diff_divergence(bx, by, bz, dx, dy, dz)
    # scale-invariant metric: compare magnitude to |B|/L characteristic
    Bmag = np.sqrt(bx*bx + by*by + bz*bz)
    # avoid zeros: use robust scale
    scaleB = max(1e-12, percentile(Bmag, 75))  # typical field strength
    norm_divB = np.abs(divB) / max(1e-12, scaleB)

    vflags = []
    divB_p95 = percentile(norm_divB, 95)
    pass_divB = divB_p95 <= tol_divB

    em_score = max(0.0, 1.0 - (divB_p95 / max(tol_divB, 1e-12)))

    stats = {
        "divB_norm_p50": percentile(norm_divB, 50),
        "divB_norm_p95": divB_p95,
        "tol_divB": tol_divB
    }

    if not pass_divB:
        vflags.append("divB_violation")

    # Optional Gauss law for E
    pass_divE = True
    if (ex is not None) and (ey is not None) and (ez is not None) and (rho is not None) and (tol_divE is not None):
        divE = finite_diff_divergence(ex, ey, ez, dx, dy, dz)
        rhs  = rho/epsilon0
        # normalize by robust scale of rhs
        scaleR = max(1e-12, percentile(np.abs(rhs), 75))
        norm_gap = np.abs(divE - rhs) / scaleR
        gap_p95 = percentile(norm_gap, 95)
        pass_divE = gap_p95 <= tol_divE
        stats.update({
            "gaussE_gap_p95": gap_p95,
            "tol_divE": tol_divE
        })
        if not pass_divE:
            vflags.append("gaussE_violation")
        # aggregate score
        em_score = 0.5*em_score + 0.5*max(0.0, 1.0 - (gap_p95 / max(tol_divE, 1e-12))))

    passed = pass_divB and pass_divE
    return {
        "id": "PCL:EM-BC-001",
        "passed": bool(passed),
        "score": float(max(0.0, min(1.0, em_score))),
        "violations": vflags,
        "stats": stats
    }


# -----------------------------
# PCL: QFT-RG-010
# -----------------------------

def pcl_qft_rg_010(model: str, alpha1: float, mu1: float, alpha2: float, mu2: float,
                   beta0: Optional[float] = None,
                   min_consistency: float = 0.6) -> Dict[str, Any]:
    """
    Heuristic 1-loop RG monotonicity:
      sign(Δα / Δln μ) ≈ sign(β0)  (β0 from chosen model or supplied)
    If beta0 is None, uses basic signs for common models:
      - "QCD": beta0 < 0 (asymptotic freedom)
      - "QED": beta0 > 0, "phi4": beta0 > 0 (typical)
    score: 1.0 if consistent, decays with deviation magnitude.
    """
    mdl = model.strip().upper()
    if beta0 is None:
        if mdl == "QCD":
            beta0 = -1.0
        elif mdl in ("QED", "PHI4", "PHI^4", "PHI-4"):
            beta0 = 1.0
        else:
            beta0 = 1.0  # default

    dln = math.log(mu2) - math.log(mu1)
    if dln == 0.0:
        return {
            "id":"PCL:QFT-RG-010","passed":False,"score":0.0,
            "violations":["rg_undefined_scale"],
            "stats":{"mu1":mu1,"mu2":mu2}
        }
    dalpha = alpha2 - alpha1
    lhs = dalpha / dln

    consistent = (lhs == 0 and beta0 == 0) or (lhs * beta0 > 0)
    # Simple score: positive margin over zero, squashed
    margin = (lhs * beta0)
    score = 1.0 / (1.0 + math.exp(-5.0*margin))  # sigmoid ~ (0,1)

    passed = consistent and (score >= min_consistency)
    vflags = [] if passed else ["beta_trend_mismatch"]
    return {
        "id": "PCL:QFT-RG-010",
        "passed": bool(passed),
        "score": float(score),
        "violations": vflags,
        "stats": {
            "model": mdl, "alpha1": alpha1, "alpha2": alpha2, "mu1": mu1, "mu2": mu2,
            "beta0": beta0, "lhs_dalpha_dlnmu": lhs, "margin": margin, "min_consistency": min_consistency
        }
    }


# -----------------------------
# COR: RES-AVOID-005 (Resonance Avoidance)
# -----------------------------

def cor_res_avoid_005(signal: np.ndarray, dt: float, drive_freq: Optional[float] = None,
                      amp_th: float = 3.0, df_th: float = 0.02, q_th: float = 10.0) -> Dict[str, Any]:
    """
    Detect near-resonance: large narrow-band peak aligned with drive frequency.
      - amp_ratio: peak / median(|FFT|)
      - df_rel   : |f_peak - f_drive| / f_drive   (if drive known)
      - Q_like   : f_peak / FWHM (higher = sharper resonance)
    Risk score in [0,1]: combine normalized components.
    If drive_freq is None, we find strongest peak and use df_rel=0 term removed.
    """
    x = np.asarray(signal).astype(float).flatten()
    n = len(x)
    if n < 16:
        return {"id":"COR:RES-AVOID-005","passed":True,"score":0.0,"violations":[],
                "stats":{"reason":"signal_too_short"}}

    # Detrend & window
    x = x - np.mean(x)
    win = np.hanning(n)
    xw = x * win
    fs = 1.0/dt
    freqs = np.fft.rfftfreq(n, d=dt)
    spec = np.abs(np.fft.rfft(xw))

    # Find primary peak
    peak_idx = int(np.argmax(spec[1:])) + 1  # skip DC
    f_peak = freqs[peak_idx]
    peak_val = spec[peak_idx]
    med = np.median(spec[1:]) + 1e-12
    amp_ratio = float(peak_val/med)

    # FWHM around peak for Q-like
    half = peak_val/2.0
    left = peak_idx
    while left > 1 and spec[left] > half:
        left -= 1
    right = peak_idx
    while right < len(spec)-1 and spec[right] > half:
        right += 1
    fwhm = max(1e-12, freqs[right] - freqs[left])
    q_like = float(f_peak / fwhm) if fwhm>0 else float('inf')

    # df relative to drive
    if drive_freq and drive_freq > 0:
        df_rel = abs(f_peak - drive_freq)/drive_freq
    else:
        df_rel = None

    # Risk scoring
    r_amp = min(1.0, amp_ratio/amp_th)                      # >amp_th → ≥1
    r_q   = min(1.0, q_like/q_th)                           # >q_th → ≥1
    if df_rel is None:
        risk = 0.5*r_amp + 0.5*r_q
    else:
        r_df  = max(0.0, 1.0 - min(1.0, df_rel/df_th))      # within df_th → near 1
        risk = 0.4*r_amp + 0.4*r_q + 0.2*r_df

    violations = []
    passed = True
    if (amp_ratio >= amp_th and q_like >= q_th and (df_rel is None or df_rel <= df_th)):
        violations.append("resonance_detected")
        passed = False

    return {
        "id":"COR:RES-AVOID-005",
        "passed": bool(passed),
        "score": float(risk),
        "violations": violations,
        "stats": {
            "f_peak": float(f_peak), "amp_ratio": amp_ratio, "q_like": q_like,
            "df_rel": (None if df_rel is None else float(df_rel)),
            "amp_th": amp_th, "df_th": df_th, "q_th": q_th,
            "n": int(n), "fs": float(fs)
        }
    }


# -----------------------------
# Gating decision
# -----------------------------

def gate_decision(em: Optional[Dict[str,Any]], qft: Optional[Dict[str,Any]], res: Optional[Dict[str,Any]],
                  policy: Optional[Dict[str,Any]] = None) -> Dict[str,Any]:
    pol = policy or {}
    res_pol = pol.get("res", {"block_score":0.85, "hold_score":0.6})

    reasons: List[str] = []
    decision = "ALLOW"
    score = 0.0

    # Hard PCL violations → BLOCK
    for chk in [em, qft]:
        if chk and (not chk["passed"]):
            reasons.append(f"pcl_violation:{chk['id']}")
            decision = "BLOCK"

    # Resonance risk score gates HOLD/BLOCK if not already BLOCK
    if res is not None:
        score = float(res["score"])
        if decision != "BLOCK":
            if score >= res_pol.get("block_score", 0.85):
                decision = "BLOCK"
                reasons.append("resonance_risk_high")
            elif score >= res_pol.get("hold_score", 0.6):
                decision = "HOLD"
                reasons.append("resonance_risk_moderate")

        if not res["passed"]:
            # explicit resonance detected → escalate
            decision = "BLOCK"
            if "resonance_detected" not in reasons:
                reasons.append("resonance_detected")

    return {
        "decision": decision,
        "reasons": reasons,
        "resonance_score": score,
        "checks": {
            "em": em,
            "qft": qft,
            "res": res
        }
    }


