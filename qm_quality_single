# Create the single-file Quantum Mechanics quality module as requested.
from textwrap import dedent

code = dedent(r'''
#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
QM Quality Module – single-file
-------------------------------
Implements three core automatic checks needed in QC/Simulation QA:

  • PCL:QM-UNIT-001  Unitarity  : ||U†U - I|| ≤ tol  (default tol=1e-6, Frobenius norm)
  • PCL:QM-BORN-002  Born-fit   : empirical vs theoretical probabilities (L1 distance ≤ eps)
  • PCL:QM-COMM-003  Commutator : ||[A,B] - expected|| / scale ≤ tol

Also includes:
  • State normalization check: |⟨ψ|ψ⟩ - 1| ≤ tol  (default tol=1e-8)
  • A 'gate' command that aggregates the above and emits pass/fail JSON array
    compatible with quality_gate_single.py and ARIL bundles.

I/O
---
- Matrices/vectors: .npy (numpy save) or .csv (real/complex; 'i' or 'j' allowed)
- Counts: counts.json (list/array) or counts.csv (one column)
- Basis: unitary matrix with columns as measurement basis vectors, or POVM projectors as separate files.

Examples
--------
# 1) Unitarity
python qm_quality_single.py check-unitary --U u.npy --tol 1e-6 --norm fro

# 2) State normalization
python qm_quality_single.py check-state --psi psi.npy --tol 1e-8

# 3) Born-fit with basis & counts
python qm_quality_single.py check-born --psi psi.npy --basis basis.npy \
  --counts counts.csv --eps 0.02

# 4) Born-fit with projectors (P0.npy P1.npy ...)
python qm_quality_single.py check-born --psi psi.npy --projectors P0.npy P1.npy P2.npy \
  --counts counts.json --eps 0.02

# 5) Commutator (expect 0)
python qm_quality_single.py check-comm --A A.npy --B B.npy --tol 1e-6

# 6) Commutator (expect iℏ I)
python qm_quality_single.py check-comm --A X.npy --B P.npy --expect-iI --hbar 1.0 --tol 1e-6

# 7) Gate: run multiple checks and emit list for the quality gate
python qm_quality_single.py gate \
  --U u.npy --psi psi.npy --basis basis.npy --counts counts.csv \
  --A X.npy --B P.npy --expect-iI --hbar 1.0 \
  --unitary-tol 1e-6 --state-tol 1e-8 --born-eps 0.02 --comm-tol 1e-6 \
  --out checks.json
"""
from __future__ import annotations
import argparse, json, math, cmath, re
from pathlib import Path
from typing import Any, Dict, List, Optional, Tuple

import numpy as np

# -------------------------
# IO helpers
# -------------------------

def _load_complex_csv(path: Path) -> np.ndarray:
    # Allow 'i' or 'j' imaginary suffix in CSV (e.g., "0.5+0.3i")
    text = path.read_text(encoding="utf-8")
    text = re.sub(r'([+-]\s*\d*\.?\d+)\s*i', r'\\1j', text)  # replace 'i' with 'j' carefully
    # Replace possible unicode commas; ensure delimiter is comma or whitespace
    try:
        arr = np.genfromtxt(text.splitlines(), delimiter=",", dtype=complex)
        if arr.ndim == 0:
            arr = np.array([[arr]])
        return arr
    except Exception:
        # whitespace-separated fallback
        arr = np.genfromtxt(text.splitlines(), dtype=complex)
        if arr.ndim == 0:
            arr = np.array([[arr]])
        return arr

def load_array(path_str: str) -> np.ndarray:
    p = Path(path_str)
    if not p.exists():
        raise FileNotFoundError(path_str)
    if p.suffix.lower() == ".npy":
        return np.load(p)
    elif p.suffix.lower() == ".csv":
        return _load_complex_csv(p)
    else:
        # Try numpy loader; fallback to CSV
        try:
            return np.load(p, allow_pickle=False)
        except Exception:
            return _load_complex_csv(p)

def load_counts(path_str: str) -> np.ndarray:
    p = Path(path_str)
    if not p.exists():
        raise FileNotFoundError(path_str)
    if p.suffix.lower() == ".json":
        data = json.loads(p.read_text(encoding="utf-8"))
        arr = np.asarray(data, dtype=float).flatten()
    else:
        arr = np.loadtxt(p, delimiter=",", dtype=float).flatten()
    if arr.size == 0:
        raise ValueError("counts file is empty")
    if np.any(arr < 0):
        raise ValueError("counts must be nonnegative")
    return arr

# -------------------------
# Norms and utilities
# -------------------------

def fro_norm(M: np.ndarray) -> float:
    return float(np.sqrt(np.sum(np.abs(M)**2)))

def spectral_norm(M: np.ndarray) -> float:
    # 2-norm via largest singular value
    return float(np.linalg.svd(M, compute_uv=False).max())

def identity(n: int, dtype=complex) -> np.ndarray:
    I = np.zeros((n, n), dtype=dtype)
    np.fill_diagonal(I, 1.0)
    return I

# -------------------------
# Checks
# -------------------------

def check_unitary(U: np.ndarray, tol: float = 1e-6, norm: str = "fro") -> Dict[str, Any]:
    if U.ndim != 2 or U.shape[0] != U.shape[1]:
        raise ValueError("U must be a square matrix.")
    I = identity(U.shape[0], dtype=complex)
    resid = U.conj().T @ U - I
    nrm = fro_norm(resid) if norm == "fro" else spectral_norm(resid)
    passed = (nrm <= tol)
    return {
        "id": "PCL:QM-UNIT-001",
        "passed": bool(passed),
        "score": float(max(0.0, 1.0 - nrm/max(tol,1e-16))),  # simple scaled score
        "stats": {"residual_norm": nrm, "tol": tol, "norm": norm, "dim": U.shape[0]}
    }

def check_state_normalization(psi: np.ndarray, tol: float = 1e-8) -> Dict[str, Any]:
    v = psi.flatten().astype(complex)
    norm2 = float(np.vdot(v, v).real)
    dev = abs(norm2 - 1.0)
    passed = (dev <= tol)
    return {
        "id": "PCL:QM-NORM-000",
        "passed": bool(passed),
        "score": float(max(0.0, 1.0 - dev/max(tol,1e-16))),
        "stats": {"norm2": norm2, "deviation": dev, "tol": tol, "dim": v.size}
    }

def theoretical_probs_from_basis(psi: np.ndarray, basis: np.ndarray) -> np.ndarray:
    # basis columns are measurement vectors |phi_i>
    if basis.ndim != 2 or basis.shape[0] != psi.size:
        raise ValueError("basis must be (d,d) with columns as basis vectors; matches psi dimension.")
    amps = basis.conj().T @ psi.reshape((-1,1))
    p = np.abs(amps.flatten())**2
    s = p.sum()
    if s <= 0:
        raise ValueError("computed probabilities sum to zero")
    return p / s

def theoretical_probs_from_projectors(psi: np.ndarray, projectors: List[np.ndarray]) -> np.ndarray:
    p = []
    v = psi.reshape((-1,1))
    for P in projectors:
        if P.shape[0] != v.shape[0] or P.shape[1] != v.shape[0]:
            raise ValueError("projector dimension mismatch")
        pv = float(np.vdot(v, (P @ v)).real)  # <psi|P|psi>
        p.append(max(0.0, pv))
    p = np.array(p, dtype=float)
    s = p.sum()
    if s <= 0:
        raise ValueError("sum of projector probabilities is zero")
    return p / s

def l1_distance(p: np.ndarray, q: np.ndarray) -> float:
    return float(np.sum(np.abs(p - q)))

def check_born(psi: np.ndarray, basis: Optional[np.ndarray], projectors: Optional[List[np.ndarray]],
               counts: Optional[np.ndarray], eps: float = 0.02) -> Dict[str, Any]:
    if basis is None and not projectors:
        raise ValueError("Provide either a measurement basis matrix or one or more projector matrices.")
    if basis is not None and projectors:
        raise ValueError("Provide either basis OR projectors, not both.")
    if basis is not None:
        p_theory = theoretical_probs_from_basis(psi, basis)
    else:
        p_theory = theoretical_probs_from_projectors(psi, projectors)  # type: ignore

    stats: Dict[str, Any] = {"eps": eps}
    if counts is None:
        # Only report theory probabilities; pass trivially with score=1
        return {
            "id": "PCL:QM-BORN-002",
            "passed": True,
            "score": 1.0,
            "stats": {**stats, "p_theory": p_theory.tolist(), "note": "no empirical counts provided"}
        }

    total = float(np.sum(counts))
    if total <= 0:
        raise ValueError("counts sum must be > 0")
    p_emp = (counts.astype(float) / total).flatten()
    if p_emp.size != p_theory.size:
        raise ValueError(f"counts length ({p_emp.size}) must match number of outcomes ({p_theory.size})")
    d1 = l1_distance(p_emp, p_theory)
    passed = (d1 <= eps)
    score = max(0.0, 1.0 - d1/max(eps,1e-16))
    stats.update({"L1": d1, "p_emp": p_emp.tolist(), "p_theory": p_theory.tolist()})
    return {
        "id": "PCL:QM-BORN-002",
        "passed": bool(passed),
        "score": float(score),
        "stats": stats
    }

def check_commutator(A: np.ndarray, B: np.ndarray,
                     expect: str = "zero",
                     hbar: float = 1.0,
                     expect_matrix: Optional[np.ndarray] = None,
                     tol: float = 1e-6) -> Dict[str, Any]:
    if A.shape != B.shape or A.ndim != 2 or A.shape[0] != A.shape[1]:
        raise ValueError("A and B must be square matrices of the same shape.")
    comm = A @ B - B @ A
    n = A.shape[0]
    if expect == "zero":
        resid = comm
        label = "0"
    elif expect == "iI":
        resid = comm - (1j*hbar)*identity(n, dtype=complex)
        label = f"i*{hbar}*I"
    elif expect == "matrix":
        if expect_matrix is None or expect_matrix.shape != comm.shape:
            raise ValueError("Provide --expect-matrix path with same shape as A,B.")
        resid = comm - expect_matrix
        label = "E (user-matrix)"
    else:
        raise ValueError("expect must be one of: zero, iI, matrix")
    # normalize by scale to avoid trivial scaling issues
    scale = max(1e-12, fro_norm(A) + fro_norm(B))
    rel = fro_norm(resid) / scale
    passed = (rel <= tol)
    return {
        "id": "PCL:QM-COMM-003",
        "passed": bool(passed),
        "score": float(max(0.0, 1.0 - rel/max(tol,1e-16))),
        "stats": {"relative_resid": rel, "tol": tol, "expect": label, "dim": n}
    }

# -------------------------
# CLI
# -------------------------

def cmd_check_unitary(args) -> Dict[str, Any]:
    U = load_array(args.U)
    return check_unitary(U, tol=args.tol, norm=args.norm)

def cmd_check_state(args) -> Dict[str, Any]:
    psi = load_array(args.psi)
    return check_state_normalization(psi, tol=args.tol)

def cmd_check_born(args) -> Dict[str, Any]:
    psi = load_array(args.psi).flatten()
    basis = load_array(args.basis) if args.basis else None
    projs = [load_array(p) for p in (args.projectors or [])] if args.projectors else None
    counts = load_counts(args.counts) if args.counts else None
    return check_born(psi, basis, projs, counts, eps=args.eps)

def cmd_check_comm(args) -> Dict[str, Any]:
    A = load_array(args.A)
    B = load_array(args.B)
    expM = load_array(args.expect_matrix) if args.expect_matrix else None
    expect = "iI" if args.expect_iI else ("matrix" if expM is not None else "zero")
    return check_commutator(A, B, expect=expect, hbar=args.hbar, expect_matrix=expM, tol=args.tol)

def cmd_gate(args) -> List[Dict[str, Any]]:
    out: List[Dict[str, Any]] = []
    if args.U:
        out.append(cmd_check_unitary(args_namespace(
            U=args.U, tol=args.unitary_tol, norm=args.unitary_norm)))
    if args.psi:
        out.append(cmd_check_state(args_namespace(
            psi=args.psi, tol=args.state_tol)))
    if args.psi and (args.basis or args.projectors):
        out.append(cmd_check_born(args_namespace(
            psi=args.psi, basis=args.basis, projectors=args.projectors,
            counts=args.counts, eps=args.born_eps)))
    if args.A and args.B:
        out.append(cmd_check_comm(args_namespace(
            A=args.A, B=args.B, expect_iI=args.expect_iI, expect_matrix=args.expect_matrix,
            hbar=args.hbar, tol=args.comm_tol)))
    # write
    text = json.dumps(out, ensure_ascii=False, indent=2, sort_keys=True)
    if args.out:
        Path(args.out).write_text(text, encoding="utf-8")
        print(f"[OK] checks written: {args.out}")
    else:
        print(text)
    return out

def args_namespace(**kw):
    return argparse.Namespace(**kw)

def main(argv=None):
    ap = argparse.ArgumentParser(description="QM Quality Module – Unitary/Born/Commutator checks")
    sub = ap.add_subparsers(dest="cmd", required=True)

    pu = sub.add_parser("check-unitary", help="PCL:QM-UNIT-001")
    pu.add_argument("--U", required=True, help="Unitary matrix (.npy/.csv)")
    pu.add_argument("--tol", type=float, default=1e-6)
    pu.add_argument("--norm", choices=["fro","spectral"], default="fro")

    ps = sub.add_parser("check-state", help="State normalization")
    ps.add_argument("--psi", required=True, help="State vector (.npy/.csv)")
    ps.add_argument("--tol", type=float, default=1e-8)

    pb = sub.add_parser("check-born", help="PCL:QM-BORN-002")
    pb.add_argument("--psi", required=True, help="State vector (.npy/.csv)")
    pb.add_argument("--basis", help="Measurement basis matrix (.npy/.csv) with columns as basis vectors")
    pb.add_argument("--projectors", nargs="*", help="One or more projector matrices (.npy/.csv)")
    pb.add_argument("--counts", help="counts.json or counts.csv (empirical)")
    pb.add_argument("--eps", type=float, default=0.02)

    pc = sub.add_parser("check-comm", help="PCL:QM-COMM-003")
    pc.add_argument("--A", required=True, help="Operator A (.npy/.csv)")
    pc.add_argument("--B", required=True, help="Operator B (.npy/.csv)")
    pc.add_argument("--expect-iI", dest="expect_iI", action="store_true", help="Expect [A,B] = iħ I")
    pc.add_argument("--hbar", type=float, default=1.0)
    pc.add_argument("--expect-matrix", help="Provide expected commutator matrix (.npy/.csv)")
    pc.add_argument("--tol", type=float, default=1e-6)

    pg = sub.add_parser("gate", help="Aggregate multiple checks, emit list JSON")
    pg.add_argument("--U")
    pg.add_argument("--psi")
    pg.add_argument("--basis")
    pg.add_argument("--projectors", nargs="*")
    pg.add_argument("--counts")
    pg.add_argument("--A")
    pg.add_argument("--B")
    pg.add_argument("--expect-iI", dest="expect_iI", action="store_true")
    pg.add_argument("--expect-matrix")
    pg.add_argument("--hbar", type=float, default=1.0)
    pg.add_argument("--unitary-tol", type=float, default=1e-6)
    pg.add_argument("--unitary-norm", choices=["fro","spectral"], default="fro")
    pg.add_argument("--state-tol", type=float, default=1e-8)
    pg.add_argument("--born-eps", type=float, default=0.02)
    pg.add_argument("--comm-tol", type=float, default=1e-6)
    pg.add_argument("--out")

    args = ap.parse_args(argv)

    if args.cmd == "check-unitary":
        res = cmd_check_unitary(args)
        print(json.dumps(res, ensure_ascii=False, indent=2, sort_keys=True))
        return 0
    if args.cmd == "check-state":
        res = cmd_check_state(args)
        print(json.dumps(res, ensure_ascii=False, indent=2, sort_keys=True))
        return 0
    if args.cmd == "check-born":
        res = cmd_check_born(args)
        print(json.dumps(res, ensure_ascii=False, indent=2, sort_keys=True))
        return 0
    if args.cmd == "check-comm":
        res = cmd_check_comm(args)
        print(json.dumps(res, ensure_ascii=False, indent=2, sort_keys=True))
        return 0
    if args.cmd == "gate":
        cmd_gate(args)
        return 0
    return 2

if __name__ == "__main__":
    raise SystemExit(main())
''')

