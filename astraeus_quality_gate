"""
astraeus_quality_gate.py
Astraeus Quality Gate v0.1 — Single-file Demo

역할:
- 텍스트(코드/문서 등)를 입력받아
  ΔS, ΔR, CHI, ECR 비슷한 지표를 간단히 근사 계산하고
  기준에 따라 PASS/FAIL + ψ-log를 출력하는 품질 게이트 예제.

주의:
- 연구·데모용 근사치이며, 실제 Astraeus 엔진의 내부 수식/구현과는 다를 수 있음.
- 나중에 AstraeusEngine v1/v1.5/v2와 연결할 수 있도록 인터페이스를 단순하게 유지.
"""

from __future__ import annotations

from dataclasses import dataclass, asdict
from typing import Dict, Any, Optional, Tuple
import math
import statistics


# ─────────────────────────────────────────────
# 0. 데이터 구조
# ─────────────────────────────────────────────

@dataclass
class GateConfig:
    """게이트 설정값.

    - max_delta_r : 허용 가능한 위험 변화량 상한
    - min_chi     : 허용 가능한 인과 조화 지수 하한
    - min_ecr     : 효율/일관성 지수 하한
    """

    max_delta_r: float = 0.03
    min_chi: float = 0.90
    min_ecr: float = 0.90


@dataclass
class PsiLog:
    """ψ-log 간단 버전."""

    chi: float
    ecr: float
    delta_s: float
    delta_r: float
    reflex: float
    taeguk_label: str
    extra: Dict[str, Any]


@dataclass
class GateResult:
    """품질 게이트 결과."""

    passed: bool
    reason: str
    psi_log: PsiLog


# ─────────────────────────────────────────────
# 1. 유틸 함수들
# ─────────────────────────────────────────────

def _tokenize(text: str) -> list[str]:
    # 아주 단순한 토큰화: 공백 기준
    return [t for t in text.strip().split() if t]


def _entropy(tokens: list[str]) -> float:
    """토큰 분포 기반 엔트로피 근사."""
    if not tokens:
        return 0.0
    freq: Dict[str, int] = {}
    for t in tokens:
        freq[t] = freq.get(t, 0) + 1

    total = float(len(tokens))
    h = 0.0
    for c in freq.values():
        p = c / total
        h -= p * math.log(p + 1e-12)
    return float(h)


def _length_stats(tokens: list[str]) -> Tuple[float, float]:
    """토큰 길이 평균/표준편차."""
    if not tokens:
        return 0.0, 0.0
    lengths = [len(t) for t in tokens]
    mean = statistics.fmean(lengths)
    std = statistics.pstdev(lengths)
    return float(mean), float(std)


def _cosine_similarity(a: Dict[str, float], b: Dict[str, float]) -> float:
    """간단한 bag-of-words 코사인 유사도."""
    if not a or not b:
        return 0.0
    keys = set(a.keys()) | set(b.keys())
    num = 0.0
    na = 0.0
    nb = 0.0
    for k in keys:
        va = a.get(k, 0.0)
        vb = b.get(k, 0.0)
        num += va * vb
        na += va * va
        nb += vb * vb
    if na == 0.0 or nb == 0.0:
        return 0.0
    return float(num / (math.sqrt(na) * math.sqrt(nb)))


def _bow(tokens: list[str]) -> Dict[str, float]:
    """bag-of-words 벡터."""
    if not tokens:
        return {}
    freq: Dict[str, int] = {}
    for t in tokens:
        freq[t] = freq.get(t, 0) + 1
    total = float(len(tokens))
    return {k: v / total for k, v in freq.items()}


# ─────────────────────────────────────────────
# 2. 메트릭 근사
# ─────────────────────────────────────────────

@dataclass
class Metrics:
    delta_s: float
    delta_r: float
    chi: float
    ecr: float


def estimate_metrics(
    before: str,
    after: str,
) -> Metrics:
    """간단한 ΔS, ΔR, CHI, ECR 근사.

    - ΔS : 엔트로피(before→after) 변화량
    - ΔR : 길이/변동 정도 기반 위험 근사
    - CHI: before/after 의미 일관성(코사인 유사도 기반)
    - ECR: 간단한 '효율 지수' (정보 대비 길이)
    """

    before_tokens = _tokenize(before)
    after_tokens = _tokenize(after)

    # 엔트로피
    h_before = _entropy(before_tokens)
    h_after = _entropy(after_tokens)
    delta_s = h_after - h_before

    # bag-of-words 코사인 → CHI
    bow_before = _bow(before_tokens)
    bow_after = _bow(after_tokens)
    chi = _cosine_similarity(bow_before, bow_after)

    # 길이 및 변화율 기반 위험 근사 ΔR
    len_before = max(1, len(before_tokens))
    len_after = max(1, len(after_tokens))
    length_ratio = len_after / len_before
    # 1에서 멀어질수록 위험 ↑, 엔트로피 폭주도 고려
    delta_r = abs(length_ratio - 1.0) + 0.1 * abs(delta_s)

    # ECR: 간단히 "정보량 / 길이" 비율 근사 (높을수록 좋다 가정)
    info_after = h_after
    ecr_raw = info_after / len_after
    # 0~1 스케일로 squash (데모용)
    ecr = 1.0 / (1.0 + math.exp(-5.0 * (ecr_raw - 0.05)))

    return Metrics(
        delta_s=float(delta_s),
        delta_r=float(delta_r),
        chi=float(chi),
        ecr=float(ecr),
    )


# ─────────────────────────────────────────────
# 3. 품질 게이트 본체
# ─────────────────────────────────────────────

class AstraeusQualityGate:
    """Astraeus Quality Gate v0.1 — 단일 파일 버전.

    예시 사용:
        gate = AstraeusQualityGate()
        result = gate.evaluate(before_text, after_text)
    """

    def __init__(self, config: Optional[GateConfig] = None) -> None:
        self.config = config or GateConfig()

    def evaluate(self, before: str, after: str) -> GateResult:
        metrics = estimate_metrics(before, after)

        # 간단한 reflex: 위험 경보 강도 (0~1 근사)
        reflex = min(1.0, max(0.0, metrics.delta_r / max(self.config.max_delta_r, 1e-6)))

        # 태극 레이블: 위험/조화도 기반 간단 분류
        if metrics.delta_r > self.config.max_delta_r * 1.5:
            taeguk_label = "boundary"
        elif metrics.chi < self.config.min_chi * 0.8:
            taeguk_label = "outer"
        else:
            taeguk_label = "internal"

        # 게이트 통과 여부
        passed = (
            metrics.delta_r <= self.config.max_delta_r
            and metrics.chi >= self.config.min_chi
            and metrics.ecr >= self.config.min_ecr
        )

        if passed:
            reason = (
                f"PASS: ΔR={metrics.delta_r:.4f} ≤ {self.config.max_delta_r}, "
                f"CHI={metrics.chi:.4f} ≥ {self.config.min_chi}, "
                f"ECR={metrics.ecr:.4f} ≥ {self.config.min_ecr}"
            )
        else:
            reason = (
                "FAIL: "
                f"ΔR={metrics.delta_r:.4f} (≤ {self.config.max_delta_r} 필요), "
                f"CHI={metrics.chi:.4f} (≥ {self.config.min_chi} 필요), "
                f"ECR={metrics.ecr:.4f} (≥ {self.config.min_ecr} 필요)"
            )

        psi_log = PsiLog(
            chi=metrics.chi,
            ecr=metrics.ecr,
            delta_s=metrics.delta_s,
            delta_r=metrics.delta_r,
            reflex=reflex,
            taeguk_label=taeguk_label,
            extra={
                "config": asdict(self.config),
                "note": "demo-only approximate metrics",
            },
        )

        return GateResult(
            passed=passed,
            reason=reason,
            psi_log=psi_log,
        )


# ─────────────────────────────────────────────
# 4. CLI 예제
# ─────────────────────────────────────────────

def _demo() -> None:
    print("=== Astraeus Quality Gate v0.1 Demo ===")
    before = input("[before] 기존 텍스트/코드를 입력하세요:\n> ")
    after = input("\n[after] 변경된 텍스트/코드를 입력하세요:\n> ")

    gate = AstraeusQualityGate()
    result = gate.evaluate(before, after)

    print("\n--- Gate Result ---")
    print("PASSED:", result.passed)
    print("REASON:", result.reason)
    print("\nψ-log:")
    for k, v in asdict(result.psi_log).items():
        print(f"  {k}: {v}")


if __name__ == "__main__":
    _demo()
