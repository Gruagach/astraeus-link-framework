# ----------------------------
# Bundle builder / verifier
# ----------------------------

AABZ_META_DIR = "ARIL/"
MANIFEST_NAME = AABZ_META_DIR + "manifest.json"
MANIFEST_SHA_NAME = AABZ_META_DIR + "manifest.sha256"
PSILOG_NAME = AABZ_META_DIR + "psi-log.jsonl"
PCL_NAME = AABZ_META_DIR + "pcl-results.json"
TSA_TSR_NAME = AABZ_META_DIR + "tsa.tsr"
OTS_PROOF_NAME = AABZ_META_DIR + "btc.ots"
SIGNATURES_NAME = AABZ_META_DIR + "signatures.json"

def detect_mime(path: Path) -> str:
    # ultra-minimal
    ext = path.suffix.lower()
    if ext in {".json", ".jsonl"}: return "application/json"
    if ext in {".csv"}: return "text/csv"
    if ext in {".txt", ".md"}: return "text/plain"
    if ext in {".ipynb"}: return "application/x-ipynb+json"
    if ext in {".py"}: return "text/x-python"
    return "application/octet-stream"

def collect_artifacts(paths: List[Path], compute_cid: bool) -> List[Artifact]:
    arts: List[Artifact] = []
    for p in paths:
        h = sha256_file(p)
        cid = None
        if compute_cid:
            cid = to_cid_v1_sha256(h.split(':',1)[1])
        arts.append(Artifact(
            path=str(p),
            size=p.stat().st_size,
            hash=h,
            cid=cid,
            mime=detect_mime(p),
        ))
    return arts

def write_manifest(arts: List[Artifact], psi_metrics: Dict[str, Any], notes: Dict[str, Any], ro_crate_present: bool) -> Tuple[Manifest, bytes, bytes]:
    root = merkle_root([a.hash for a in arts])
    m = Manifest(
        created_at=now_iso(),
        artifacts=arts,
        merkle_root=root,
        psi_metrics=psi_metrics or {},
        notes=notes or {},
        ro_crate_present=ro_crate_present,
    )
    manifest_json = m.to_json().encode('utf-8')
    manifest_sha = hashlib.sha256(manifest_json).hexdigest().encode('ascii')
    return m, manifest_json, manifest_sha

def add_file_to_zip(zipf: zipfile.ZipFile, arcname: str, data: bytes):
    zi = zipfile.ZipInfo(arcname)
    zi.date_time = time.gmtime(time.time())[:6]
    zi.compress_type = zipfile.ZIP_DEFLATED
    zipf.writestr(zi, data)

def bundle(
    out_path: Path,
    file_globs: List[str],
    psi_log_path: Optional[Path],
    pcl_path: Optional[Path],
    compute_cid: bool,
    notes_kv: List[str],
    ots: bool,
    tsa_url: Optional[str],
    tsa_tsr_path: Optional[Path],
    use_curl: bool,
    openssl_bin: str,
) -> None:
    files = normalize_globs(file_globs)
    if not files:
        raise SystemExit("No input files matched. Provide --data/--code-path/--artifact globs.")
    ro_crate_present = any(p.name == "ro-crate-metadata.json" for p in files)

    arts = collect_artifacts(files, compute_cid=compute_cid)
    notes: Dict[str, Any] = dict(kv.split('=',1) for kv in notes_kv) if notes_kv else {}
    psi_metrics: Dict[str, Any] = {}
    # compose manifest
    m, manifest_json, manifest_sha = write_manifest(arts, psi_metrics, notes, ro_crate_present)

    # build zip
    with zipfile.ZipFile(out_path, "w", compression=zipfile.ZIP_DEFLATED) as z:
        # add user artifacts to /
        for a in arts:
            z.write(a.path, arcname=Path(a.path).name)

        # meta
        add_file_to_zip(z, MANIFEST_NAME, manifest_json)
        add_file_to_zip(z, MANIFEST_SHA_NAME, manifest_sha)
        # optional attachments
        if psi_log_path and psi_log_path.exists():
            z.write(str(psi_log_path), arcname=PSILOG_NAME)
        if pcl_path and pcl_path.exists():
            z.write(str(pcl_path), arcname=PCL_NAME)

        # optional stamping integrations
        # 1) OTS
        if ots:
            # create temp file of manifest SHA (as canonical input for stamping)
            with tempfile.TemporaryDirectory() as td:
                tmp = Path(td) / "manifest.sha256"
                tmp.write_bytes(manifest_sha + b"\n")
                proof = run_ots_stamp(tmp)
                if proof is not None:
                    add_file_to_zip(z, OTS_PROOF_NAME, proof)

        # 2) TSA
        if tsa_url or tsa_tsr_path:
            # we stamp the manifest.json bytes (message imprint)
            tsr_data = None
            if tsa_tsr_path and tsa_tsr_path.exists():
                tsr_data = tsa_tsr_path.read_bytes()
            elif tsa_url:
                tsr_data = run_tsa_request(
                    data_bytes=manifest_json,
                    tsa_url=tsa_url,
                    use_curl=use_curl,
                    openssl_bin=openssl_bin
                )
            if tsr_data:
                add_file_to_zip(z, TSA_TSR_NAME, tsr_data)

    print(f"[OK] Bundle created: {out_path}  ({len(arts)} artifacts)")
    print(f"     Merkle root: {m.merkle_root}")
    if ots:
        print("     OTS: embedded if ots CLI available (or external proof not provided).")
    if tsa_url or tsa_tsr_path:
        print("     TSA: embedded TSR token (RFC3161).")

def verify(bundle_path: Path, openssl_bin: str) -> int:
    ok = True
    with zipfile.ZipFile(bundle_path, "r") as z:
        # read manifest and sha
        try:
            mjson = z.read(MANIFEST_NAME)
            msha = z.read(MANIFEST_SHA_NAME).strip()
        except KeyError:
            print("[ERR] manifest files missing.")
            return 2

        calc_msha = hashlib.sha256(mjson).hexdigest().encode('ascii')
        if calc_msha != msha:
            print("[ERR] manifest.sha256 mismatch!")
            ok = False
        else:
            print("[OK] manifest.sha256 matches.")

        mani = json.loads(mjson.decode('utf-8'))
        arts = mani.get("artifacts", [])
        # verify hashes of artifacts
        for a in arts:
            name = Path(a["path"]).name
            try:
                data = z.read(name)
            except KeyError:
                print(f"[ERR] artifact missing in bundle: {name}")
                ok = False
                continue
            h = 'sha256:' + hashlib.sha256(data).hexdigest()
            if h != a["hash"]:
                print(f"[ERR] hash mismatch: {name}")
                ok = False

        # verify merkle root
        merkle = mani.get("merkle_root")
        calc_root = merkle_root([a["hash"] for a in arts])
        if merkle != calc_root:
            print(f"[ERR] merkle root mismatch!\n  manifest: {merkle}\n  calc    : {calc_root}")
            ok = False
        else:
            print("[OK] merkle root matches.")

        # optional OTS verify
        if OTS_PROOF_NAME in z.namelist():
            proof = z.read(OTS_PROOF_NAME)
            with tempfile.TemporaryDirectory() as td:
                path_sha = Path(td)/"manifest.sha256"
                path_sha.write_bytes(msha + b"\n")
                path_proof = Path(td)/"btc.ots"
                path_proof.write_bytes(proof)
                res = run_ots_verify(path_sha, path_proof)
                if res is True:
                    print("[OK] OTS proof verified (external ots CLI).")
                elif res is False:
                    print("[ERR] OTS proof verification failed.")
                    ok = False
                else:
                    print("[WARN] OTS CLI not available; skipped OTS verification.")

        # optional TSA verify (requires TSA certs and openssl ts -verify support)
        if TSA_TSR_NAME in z.namelist():
            tsr = z.read(TSA_TSR_NAME)
            with tempfile.TemporaryDirectory() as td:
                p_mjson = Path(td)/"manifest.json"
                p_tsr   = Path(td)/"tsa.tsr"
                p_mjson.write_bytes(mjson)
                p_tsr.write_bytes(tsr)
                res = run_tsa_verify(p_mjson, p_tsr, openssl_bin=openssl_bin)
                if res is True:
                    print("[OK] TSA token verified (openssl).")
                elif res is False:
                    print("[ERR] TSA token verification failed.")
                    ok = False
                else:
                    print("[WARN] OpenSSL not available; skipped TSA verification.")

    return 0 if ok else 1

def inspect_bundle(bundle_path: Path) -> None:
    with zipfile.ZipFile(bundle_path, "r") as z:
        mjson = z.read(MANIFEST_NAME).decode('utf-8')
        mani = json.loads(mjson)
        print(json.dumps(mani, ensure_ascii=False, indent=2))

# ----------------------------
# External tool bridges (best-effort)
# ----------------------------

def have_cmd(name: str) -> bool:
    return shutil.which(name) is not None

def run_ots_stamp(path_sha256: Path) -> Optional[bytes]:
    if not have_cmd("ots"):
        return None
    # ots stamp writes sidecar .ots next to the input file
    try:
        subprocess.run(["ots", "stamp", str(path_sha256)], check=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
        proof_path = path_sha256.with_suffix(path_sha256.suffix + ".ots")
        if proof_path.exists():
            return proof_path.read_bytes()
    except subprocess.CalledProcessError as e:
        sys.stderr.write(f"[WARN] ots stamp failed: {e}\n")
    return None

def run_ots_verify(path_sha256: Path, path_proof: Path) -> Optional[bool]:
    if not have_cmd("ots"):
        return None
    try:
        subprocess.run(["ots", "verify", str(path_proof), str(path_sha256)], check=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
        return True
    except subprocess.CalledProcessError:
        return False

def run_tsa_request(data_bytes: bytes, tsa_url: str, use_curl: bool, openssl_bin: str = "openssl") -> Optional[bytes]:
    """
    Best-effort RFC3161 timestamp request using openssl + curl. We:
      (1) create TSQ on data (sha256)
      (2) POST to tsa_url with curl
      (3) return TSR bytes
    """
    if not have_cmd(openssl_bin):
        sys.stderr.write("[WARN] OpenSSL not available; skipping TSA.\n")
        return None
    with tempfile.TemporaryDirectory() as td:
        p_data = Path(td)/"data.bin"
        p_tsq  = Path(td)/"req.tsq"
        p_tsr  = Path(td)/"resp.tsr"
        p_data.write_bytes(data_bytes)
        try:
            # Create TSQ
            subprocess.run([openssl_bin, "ts", "-query", "-data", str(p_data), "-sha256", "-cert", "-no_nonce", "-out", str(p_tsq)], check=True)
            if use_curl and have_cmd("curl"):
                # Submit via curl
                subprocess.run(["curl", "-sS", "-H", "Content-Type: application/timestamp-query", "--data-binary", f"@{p_tsq}", "-o", str(p_tsr), tsa_url], check=True)
                return p_tsr.read_bytes()
            else:
                # If curl not used, user can submit p_tsq manually and provide --tsa-tsr later
                sys.stderr.write("[INFO] TSQ generated; submit to TSA externally or enable --tsa-curl.\n")
                return None
        except subprocess.CalledProcessError as e:
            sys.stderr.write(f"[WARN] TSA request failed: {e}\n")
            return None

def run_tsa_verify(path_data: Path, path_tsr: Path, openssl_bin: str = "openssl") -> Optional[bool]:
    if not have_cmd(openssl_bin):
        return None
    # OpenSSL verify requires -CAfile or -CApath for TSA certs in strict mode.
    # We use '-verify' without chain checks here (format validation). For full
    # validation, provide certs and extend the command accordingly.
    try:
        subprocess.run([openssl_bin, "ts", "-verify", "-data", str(path_data), "-in", str(path_tsr)], check=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
        return True
    except subprocess.CalledProcessError:
        return False

# ----------------------------
# Argument parsing
# ----------------------------

def parse_args(argv: Optional[List[str]] = None) -> argparse.Namespace:
    p = argparse.ArgumentParser(description="ARIL – Astraeus Research Integrity Ledger (single-file)")
    sub = p.add_subparsers(dest="cmd", required=True)

    pb = sub.add_parser("bundle", help="Create an assurance bundle (.aabz)")
    pb.add_argument("--data", nargs="*", default=[], help="Data file globs")
    pb.add_argument("--code-path", nargs="*", default=[], help="Code file globs")
    pb.add_argument("--artifact", nargs="*", default=[], help="Other artifact globs (notebook, docs, etc.)")
    pb.add_argument("--psi-log", type=Path, help="psi-log.jsonl path (optional)")
    pb.add_argument("--pcl", type=Path, help="pcl-results.json path (optional)")
    pb.add_argument("--out", type=Path, required=True, help="Output .aabz path")
    pb.add_argument("--cid", action="store_true", help="Compute CIDv1 (sha2-256) for artifacts")
    pb.add_argument("--note", action="append", default=[], help="Free-form note key=value (repeatable)")
    # stamping
    pb.add_argument("--stamp-ots", dest="ots", action="store_true", help="Stamp with OpenTimestamps if ots CLI present")
    pb.add_argument("--tsa-url", type=str, help="RFC3161 TSA URL (POST)")
    pb.add_argument("--tsa-tsr", type=Path, help="Attach an existing TSA response (.tsr)")
    pb.add_argument("--tsa-curl", action="store_true", help="Use curl to POST TSQ to TSA")
    pb.add_argument("--openssl-bin", default="openssl", help="OpenSSL binary name/path")

    pv = sub.add_parser("verify", help="Verify an assurance bundle (.aabz)")
    pv.add_argument("bundle", type=Path, help="Path to .aabz")
    pv.add_argument("--openssl-bin", default="openssl", help="OpenSSL binary name/path")

    pi = sub.add_parser("inspect", help="Print manifest.json in bundle")
    pi.add_argument("bundle", type=Path, help="Path to .aabz")

    return p.parse_args(argv)

def main(argv: Optional[List[str]] = None) -> int:
    args = parse_args(argv)
    if args.cmd == "bundle":
        globs = []
        globs += args.data or []
        globs += args.code_path or []
        globs += args.artifact or []
        bundle(
            out_path=args.out,
            file_globs=globs,
            psi_log_path=args.psi_log,
            pcl_path=args.pcl,
            compute_cid=args.cid,
            notes_kv=args.note,
            ots=args.ots,
            tsa_url=args.tsa_url,
            tsa_tsr_path=args.tsa_tsr,
            use_curl=args.tsa_curl,
            openssl_bin=args.openssl_bin,
        )
        return 0
    elif args.cmd == "verify":
        return verify(args.bundle, openssl_bin=args.openssl_bin)
    elif args.cmd == "inspect":
        inspect_bundle(args.bundle)
        return 0
    else:
        return 2

if __name__ == "__main__":
    raise SystemExit(main())
