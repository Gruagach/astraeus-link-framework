# ----------------------------
# Utilities
# ----------------------------

CHUNK = 1024 * 1024

def sha256_file(path: Path) -> str:
    h = hashlib.sha256()
    with open(path, 'rb') as f:
        while True:
            b = f.read(CHUNK)
            if not b:
                break
            h.update(b)
    return 'sha256:' + h.hexdigest()

def sha256_bytes(data: bytes) -> str:
    return 'sha256:' + hashlib.sha256(data).hexdigest()

def is_text_file(path: Path, sniff_bytes: int = 2048) -> bool:
    try:
        with open(path, 'rb') as f:
            sample = f.read(sniff_bytes)
        sample.decode('utf-8')
        return True
    except Exception:
        return False

def normalize_globs(globs: List[str]) -> List[Path]:
    files: List[Path] = []
    for g in globs:
        for p in Path().glob(g):
            if p.is_file():
                files.append(p)
    # de-dup & sort for determinism
    files = sorted(set([p.resolve() for p in files]))
    return files

def now_iso() -> str:
    return time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime())

# ----------------------------
# Simple CIDv1 (sha2-256) encoder
# ----------------------------
# Minimal CIDv1 constructor for sha2-256 digests.
# multibase (base32 lower) + cidv1 prefix + multicodec raw + multihash(sha2-256).
# This is a *convenience* CID (content address) not tied to IPFS daemon.

def to_cid_v1_sha256(hex_digest: str) -> str:
    # multihash: <hash fn code=0x12><length=32><digest bytes>
    digest = binascii.unhexlify(hex_digest)
    mh = bytes([0x12, 32]) + digest
    # cidv1: <cid-version=1><multicodec=0x55 (raw)> varint encoding
    def varint(x: int) -> bytes:
        out = bytearray()
        while True:
            b = x & 0x7F
            x >>= 7
            if x:
                out.append(b | 0x80)
            else:
                out.append(b)
                break
        return bytes(out)
    cid_bytes = varint(1) + varint(0x55) + mh  # 0x55 = "raw"
    # multibase base32 (lower) with 'b' prefix
    b32 = base64.b32encode(cid_bytes).decode('ascii').lower().rstrip('=')
    return 'b' + b32

# ----------------------------
# Merkle Tree (flat, SHA-256 leaves)
# ----------------------------

def merkle_root(hashes: List[str]) -> str:
    """
    Compute hex merkle root from list of 'sha256:<hex>' strings.
    """
    if not hashes:
        return 'sha256:' + '0'*64
    nodes = [h.split(':', 1)[1] for h in hashes]
    nodes = [bytes.fromhex(x) for x in nodes]
    layer = nodes
    while len(layer) > 1:
        next_layer = []
        for i in range(0, len(layer), 2):
            a = layer[i]
            b = layer[i+1] if i+1 < len(layer) else a
            next_layer.append(hashlib.sha256(a + b).digest())
        layer = next_layer
    return 'sha256:' + layer[0].hex()

